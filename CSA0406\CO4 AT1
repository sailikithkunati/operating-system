#include <stdio.h>
#define MAX_BLOCKS 1000
int main()
{
    int bitmap[MAX_BLOCKS];
    int n, i;
    int request;
    int count = 0;
    int block;
    printf("Enter total number of disk blocks: ");
    scanf("%d", &n);
    if (n <= 0 || n > MAX_BLOCKS)
    {
        printf("Invalid number of blocks.\n");
        return 1;
    }
    printf("Enter initial bitmap (0 = Free, 1 = Allocated):\n");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &bitmap[i]);
        if (bitmap[i] != 0 && bitmap[i] != 1)
        {
            printf("Invalid bitmap value.\n");
            return 1;
        }
    }
    /* Display initial bitmap */
    printf("\nInitial Bitmap:\n");
    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);
    /* Allocation */
    printf("\n\nEnter number of blocks to allocate: ");
    scanf("%d", &request);
    /* Count free blocks */
    for (i = 0; i < n; i++)
    {
        if (bitmap[i] == 0)
            count++;
    }
    if (count < request)
    {
        printf("Allocation failed.\n");
        printf("Only %d free blocks are available.\n", count);
    }
    else
    {
        count = 0;
        printf("Allocated blocks: ");
        /* Allocate the first available free blocks */
        for (i = 0; i < n && count < request; i++)
        {
            if (bitmap[i] == 0)
            {
                bitmap[i] = 1;
                printf("%d ", i);
                count++;
            }
        }
        printf("\nAllocation successful.");
    }
    /* Display bitmap after allocation */
    printf("\n\nBitmap after allocation:\n");
    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);
    /* Deallocation */
    printf("\n\nEnter block number to deallocate (-1 to stop):\n");
    while (1)
    {
        scanf("%d", &block);
        if (block == -1)
            break;
        if (block < 0 || block >= n)
        {
            printf("Invalid block number.\n");
        }
        else if (bitmap[block] == 0)
        {
            printf("Block %d is already free.\n", block);
        }
        else
        {
            bitmap[block] = 0;
            printf("Block %d deallocated successfully.\n", block);
        }
    }
    /* Display final bitmap */
    printf("\nBitmap after deallocation:\n");
    for (i = 0; i < n; i++)
        printf("%d ", bitmap[i]);
    printf("\n");
    return 0;
}

