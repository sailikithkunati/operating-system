#include <stdio.h>
#include <stdlib.h>
int main()
{
    int r[50], n, head, size, i, j, cur, seek;
    int used[50] = {0}, d, min, pos;
    printf("Enter disk size: ");
    scanf("%d", &size);
    printf("Enter number of requests: ");
    scanf("%d", &n);
    printf("Enter requests: ");
    for(i = 0; i < n; i++)
        scanf("%d", &r[i]);
    printf("Enter head position: ");
    scanf("%d", &head);
    /* FCFS */
    cur = head; seek = 0;
    printf("\nFCFS: %d", cur);
    for(i = 0; i < n; i++) {
        seek += abs(cur - r[i]);
        cur = r[i];
        printf(" -> %d", cur);
    }
    printf("\nTotal Seek = %d\n", seek);
    /* SSTF */
    cur = head; seek = 0;
    printf("\nSSTF: %d", cur);
    for(i = 0; i < n; i++) {
        min = 9999;
        for(j = 0; j < n; j++) {
            if(!used[j] && abs(cur-r[j]) < min) {
                min = abs(cur-r[j]);
                pos = j;
            }
        }
        used[pos] = 1;
        seek += min;
        cur = r[pos];
        printf(" -> %d", cur);
    }
    printf("\nTotal Seek = %d\n", seek);
    /* SCAN - move towards higher blocks */
    seek = 0;
    cur = head;
    printf("\nSCAN: %d", cur);
    for(i = 0; i < size; i++) {
        for(j = 0; j < n; j++) {
            if(r[j] == i) {
                seek += abs(cur-i);
                cur = i;
                printf(" -> %d", cur);
            }
        }
    }
    seek += abs(cur - (size-1));
    cur = size-1;
    printf(" -> %d", cur);
    for(i = size-1; i >= 0; i--) {
        for(j = 0; j < n; j++) {
            if(r[j] == i && i < head) {
                seek += abs(cur-i);
                cur = i;
                printf(" -> %d", cur);
            }
        }
    }
    printf("\nTotal Seek = %d\n", seek);
    return 0;
}


