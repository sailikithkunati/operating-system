#include <stdio.h>
#include <stdlib.h>
#define MAX 100
int main()
{
    int disk[MAX] = {0}, blocks[MAX];
    int n, fsize, head, alloc, sched;
    int req[MAX], m, i, j, count = 0;
    int cur, seek = 0, min, pos, used[MAX] = {0};
    printf("Enter total disk blocks: ");
    scanf("%d", &n);
    printf("Enter file size: ");
    scanf("%d", &fsize);
    printf("Allocation (1=Contiguous, 2=Indexed): ");
    scanf("%d", &alloc);
    printf("Scheduling (1=FCFS, 2=SSTF): ");
    scanf("%d", &sched);
    printf("Enter number of disk requests: ");
    scanf("%d", &m);
    printf("Enter request queue: ");
    for(i = 0; i < m; i++)
        scanf("%d", &req[i]);
    printf("Enter initial head position: ");
    scanf("%d", &head);
    /* File Allocation */
    if(alloc == 1) {
        int start = -1;
        for(i = 0; i <= n-fsize; i++) {
            for(j = i; j < i+fsize && disk[j] == 0; j++);
            if(j == i+fsize) {
                start = i;
                break;
            }
        }
        if(start == -1) {
            printf("\nContiguous allocation failed!\n");
            return 0;
        }
        for(i = start; i < start+fsize; i++)
            blocks[count++] = i;
    }
    else {
        /* Indexed allocation: first block is index block */
        if(fsize + 1 > n) {
            printf("\nIndexed allocation failed!\n");
            return 0;
        }
        disk[0] = 1;
        for(i = 1; i < n && count < fsize; i++)
            if(!disk[i]) {
                disk[i] = 1;
                blocks[count++] = i;
            }
    }
    printf("\nAllocated Blocks: ");
    for(i = 0; i < count; i++)
        printf("%d ", blocks[i]);
    /* Scheduling only allocated blocks */
    cur = head;
    printf("\n\nSeek Sequence: %d", cur);
    if(sched == 1) {                /* FCFS */
        for(i = 0; i < count; i++) {
            seek += abs(cur-blocks[i]);
            cur = blocks[i];
            printf(" -> %d", cur);
        }
    }
    else {                           /* SSTF */
        for(i = 0; i < count; i++) {
            min = 9999;
            pos = -1;
            for(j = 0; j < count; j++)
                if(!used[j] && abs(cur-blocks[j]) < min) {
                    min = abs(cur-blocks[j]);
                    pos = j;
                }
            used[pos] = 1;
            seek += min;
            cur = blocks[pos];
            printf(" -> %d", cur);
        }
    }
    printf("\nTotal Seek Time = %d\n", seek);
    printf("\nBest Combination:\n");
    if(sched == 1)
        printf("%s + FCFS\n",
               alloc == 1 ? "Contiguous" : "Indexed");
    else
        printf("%s + SSTF\n",
               alloc == 1 ? "Contiguous" : "Indexed");
    printf("Minimum seek time = %d\n", seek);
    return 0;
}
