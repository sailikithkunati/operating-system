#include <stdio.h>
#define MAX_BLOCKS 1000
int disk[MAX_BLOCKS];
/* Contiguous Allocation */
void contiguous(int diskSize, int fileSize)
{
    int i, j, start = -1;
    int count;
    for (i = 0; i <= diskSize - fileSize; i++)
    {
        count = 0;
        for (j = i; j < i + fileSize; j++)
        {
            if (disk[j] == 0)
                count++;
            else
                break;
        }
        if (count == fileSize)
        {
            start = i;
            break;
        }
    }
    if (start == -1)
    {
        printf("\nContiguous allocation failed.\n");
        printf("No continuous space of %d blocks is available.\n", fileSize);
        return;
    }
    printf("\nContiguous Allocation Successful\n");
    printf("Allocated blocks: ");
    for (i = start; i < start + fileSize; i++)
    {
        disk[i] = 1;
        printf("%d ", i);
    }
    printf("\n");
}
/* Linked Allocation */
void linked(int diskSize, int fileSize)
{
    int i, count = 0;
    printf("\nLinked Allocation\n");
    printf("Allocated blocks: ");
    for (i = 0; i < diskSize && count < fileSize; i++)
    {
        if (disk[i] == 0)
        {
            disk[i] = 1;
            printf("%d ", i);
            count++;
        }
    }
    if (count < fileSize)
    {
        printf("\nAllocation failed. Insufficient disk space.\n");
        /* Roll back allocated blocks */
        for (i = 0; i < diskSize; i++)
        {
            if (disk[i] == 1)
                disk[i] = 0;
        }
    }
    else
    {
        printf("\nLinked allocation successful.\n");
    }
}
/* Indexed Allocation */
void indexed(int diskSize, int fileSize)
{
    int i, indexBlock = -1;
    int count = 0;
    /* One block is required for the index block.
       Therefore, total required blocks = fileSize + 1. */
    if (fileSize + 1 > diskSize)
    {
        printf("\nIndexed allocation failed.\n");
        printf("Not enough disk blocks for index block and file data.\n");
        return;
    }
    /* Find an index block */
    for (i = 0; i < diskSize; i++)
    {
        if (disk[i] == 0)
        {
            indexBlock = i;
            disk[i] = 1;
            break;
        }
    }
    if (indexBlock == -1)
    {
        printf("\nIndexed allocation failed.\n");
        return;
    }
    printf("\nIndexed Allocation\n");
    printf("Index block: %d\n", indexBlock);
    printf("Allocated data blocks: ");
    for (i = 0; i < diskSize && count < fileSize; i++)
    {
        if (disk[i] == 0)
        {
            disk[i] = 1;
            printf("%d ", i);
            count++;
        }
    }
    if (count < fileSize)
    {
        printf("\nAllocation failed. Insufficient disk space.\n");
        /* Roll back */
        disk[indexBlock] = 0;
        for (i = 0; i < diskSize; i++)
        {
            if (disk[i] == 1)
                disk[i] = 0;
        }
    }
    else
    {
        printf("\nIndexed allocation successful.\n");
    }
}

int main()
{
    int diskSize, fileSize, method;
    int i;
    printf("Enter total disk size (number of blocks): ");
    scanf("%d", &diskSize);
    printf("Enter file size (number of blocks required): ");
    scanf("%d", &fileSize);
    if (diskSize <= 0 || diskSize > MAX_BLOCKS || fileSize <= 0)
    {
        printf("Invalid input.\n");
        return 1;
    }
    if (fileSize > diskSize)
    {
        printf("File size cannot be greater than disk size.\n");
        return 1;
    }
    printf("\nFile Allocation Methods\n");
    printf("1. Contiguous Allocation\n");
    printf("2. Linked Allocation\n");
    printf("3. Indexed Allocation\n");
    printf("\nEnter allocation method: ");
    scanf("%d", &method);
    /* Initially all disk blocks are free */
    for (i = 0; i < diskSize; i++)
        disk[i] = 0;
    switch (method)
    {
        case 1:
            contiguous(diskSize, fileSize);
            break;
        case 2:
            linked(diskSize, fileSize);
            break;
        case 3:
            indexed(diskSize, fileSize);
            break;
        default:
            printf("Invalid allocation method.\n");
    }
    return 0;
}


