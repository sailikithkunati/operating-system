        for(j = i+1; j < n; j++)
            if(r[i] > r[j]) {
                temp = r[i];
                r[i] = r[j];
                r[j] = temp;
            }
    /* C-SCAN */
    cur = head;
    seek = 0;
    printf("\nC-SCAN: %d", cur);
    if(dir == 1) {
        for(i = 0; i < n; i++)
            if(r[i] >= head) {
                seek += abs(cur-r[i]);
                cur = r[i];
                printf(" -> %d", cur);
