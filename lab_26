#include <stdio.h>
#include <stdlib.h>

int main()
{
    FILE *fp;
    char filename[50], data[200];
    int choice;

    printf("Enter file name: ");
    scanf("%s", filename);

    while (1)
    {
        printf("\n--- FILE MANAGEMENT ---\n");
        printf("1. Create File\n");
        printf("2. Write File\n");
        printf("3. Read File\n");
        printf("4. Append File\n");
        printf("5. Delete File\n");
        printf("6. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                fp = fopen(filename, "w");

                if (fp == NULL)
                    printf("File creation failed.\n");
                else
                {
                    printf("File created successfully.\n");
                    fclose(fp);
                }
                break;

            case 2:
                fp = fopen(filename, "w");

                if (fp == NULL)
                {
                    printf("Unable to open file.\n");
                    break;
                }

                printf("Enter data: ");
                scanf(" %[^\n]", data);

                fprintf(fp, "%s\n", data);
                fclose(fp);

                printf("Data written successfully.\n");
                break;

            case 3:
                fp = fopen(filename, "r");

                if (fp == NULL)
                {
                    printf("File not found.\n");
                    break;
                }

                printf("\nFile Contents:\n");

                while (fgets(data, sizeof(data), fp) != NULL)
                    printf("%s", data);

                fclose(fp);
                break;

            case 4:
                fp = fopen(filename, "a");

                if (fp == NULL)
                {
                    printf("Unable to open file.\n");
                    break;
                }

                printf("Enter data to append: ");
                scanf(" %[^\n]", data);

                fprintf(fp, "%s\n", data);
                fclose(fp);

                printf("Data appended successfully.\n");
                break;

            case 5:
                if (remove(filename) == 0)
                    printf("File deleted successfully.\n");
                else
                    printf("File deletion failed.\n");
                break;

            case 6:
                exit(0);

            default:
                printf("Invalid choice.\n");
        }
    }

    return 0;
}
