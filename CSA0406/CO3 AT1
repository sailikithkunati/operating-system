#include <stdio.h>
int main() {
    float tlbTime, memTime, hitRatio;
    float withTLB, withoutTLB;
    printf("Enter TLB Access Time: ");
    scanf("%f", &tlbTime);
    printf("Enter Memory Access Time: ");
    scanf("%f", &memTime);
    printf("Enter TLB Hit Ratio (0 to 1): ");
    scanf("%f", &hitRatio);
    withTLB = hitRatio * (tlbTime + memTime) +
              (1 - hitRatio) * (tlbTime + 2 * memTime);
    withoutTLB = 2 * memTime;
    printf("\nMemory Access Time without TLB = %.2f ns", withoutTLB);
    printf("\nEffective Memory Access Time with TLB = %.2f ns", withTLB);
    return 0;
}
OUTPUT:
Enter TLB Access Time: 10
Enter Memory Access Time: 100
Enter TLB Hit Ratio (0 to 1): 0.8

Memory Access Time without TLB = 200.00 ns
Effective Memory Access Time with TLB = 130.00 ns


