#include <stdio.h>

struct Block
{
    int blockNo;
    int next;
};

int main()
{
    struct Block blocks[50];
    int n, start, end;

    printf("Enter number of blocks in the file: ");
    scanf("%d", &n);

    printf("Enter block numbers:\n");

    for (int i = 0; i < n; i++)
    {
        scanf("%d", &blocks[i].blockNo);

        if (i < n - 1)
            blocks[i].next = i + 1;
        else
            blocks[i].next = -1;
    }

    start = 0;
    end = n - 1;

    printf("\nLinked File Allocation:\n");
    printf("Start Block = %d\n", blocks[start].blockNo);
    printf("End Block   = %d\n", blocks[end].blockNo);

    printf("\nBlock\tNext Block\n");

    int current = start;

    while (current != -1)
    {
        printf("%d\t", blocks[current].blockNo);

        if (blocks[current].next == -1)
            printf("NULL\n");
        else
            printf("%d\n",
                   blocks[blocks[current].next].blockNo);

        current = blocks[current].next;
    }

    return 0;
}
