#include <stdio.h>

int main()
{
    int block[20], process[20], allocation[20];
    int n, m;

    printf("Enter number of memory blocks: ");
    scanf("%d", &n);

    printf("Enter block sizes:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &m);

    printf("Enter process sizes:\n");
    for (int i = 0; i < m; i++)
        scanf("%d", &process[i]);

    for (int i = 0; i < m; i++)
        allocation[i] = -1;

    /* First Fit Allocation */
    for (int i = 0; i < m; i++)
    {
        for (int j = 0; j < n; j++)
        {
            if (block[j] >= process[i])
            {
                allocation[i] = j;
                block[j] -= process[i];
                break;
            }
        }
    }

    printf("\nProcess\tSize\tBlock\n");

    for (int i = 0; i < m; i++)
    {
        if (allocation[i] != -1)
            printf("P%d\t%d\tB%d\n",
                   i + 1, process[i], allocation[i] + 1);
        else
            printf("P%d\t%d\tNot Allocated\n",
                   i + 1, process[i]);
    }

    return 0;
}
